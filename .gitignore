# ==============================================================================
# CloudMD Git Ignore Rules
# ==============================================================================

# Environment files & Secrets (CRITICAL: Do NOT leak secrets)
.env
.env*.local
.env.production
.env.development
.env.test
!.env.example

# Credentials, Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
client_secret*.json
service-account*.json
*.keystore
*.jks
.secrets
secrets/
.auth/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js Build Output
/.next/
/out/
/build
/dist

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editors
.idea/
*.swp
*.swo
*~

